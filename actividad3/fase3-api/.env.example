# Copia como .env (no se sube a Git) y cambia los valores.
# Genera un secreto con:  openssl rand -base64 48
JWT_SECRETO=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
# Contraseñas de los usuarios de demostración (mínimo 12 caracteres)
CLAVE_DEMO_ADMIN=cambia-esta-clave-admin
CLAVE_DEMO_LECTOR=cambia-esta-clave-lector
# LocalStack (credenciales ficticias)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT=http://host.docker.internal:4566
